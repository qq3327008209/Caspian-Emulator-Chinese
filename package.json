{
  "name": "caspian-emulator-chinese",
  "displayName": "Caspian Emulator 汉化包",
  "description": "为 Caspian Emulator 提供简体中文界面。与 Caspian Emulator 扩展同时安装使用。",
  "version": "1.0.0",
  "publisher": "caspian-chinese",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "caspian",
    "emulator",
    "android",
    "chinese",
    "localization",
    "汉化"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qq3327008209/Caspian-Emulator-Chinese.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "caspian.setupSdk",
        "title": "配置 Android SDK"
      },
      {
        "command": "caspian.downloadSdk",
        "title": "下载并安装 Android SDK"
      },
      {
        "command": "caspian.connectPhone",
        "title": "通过 USB 连接手机"
      },
      {
        "command": "caspian.refreshAvds",
        "title": "刷新虚拟设备列表"
      },
      {
        "command": "caspian.createAvd",
        "title": "创建虚拟设备"
      },
      {
        "command": "caspian.launchAvd",
        "title": "启动模拟器"
      },
      {
        "command": "caspian.stopAvd",
        "title": "停止模拟器"
      },
      {
        "command": "caspian.deleteAvd",
        "title": "删除虚拟设备"
      },
      {
        "command": "caspian.editAvd",
        "title": "编辑虚拟设备配置"
      },
      {
        "command": "caspian.refreshDevices",
        "title": "刷新设备列表"
      },
      {
        "command": "caspian.installApk",
        "title": "安装 APK"
      },
      {
        "command": "caspian.takeScreenshot",
        "title": "截取屏幕"
      },
      {
        "command": "caspian.recordScreen",
        "title": "录制屏幕"
      },
      {
        "command": "caspian.openShell",
        "title": "打开 ADB Shell"
      },
      {
        "command": "caspian.showLogcat",
        "title": "显示日志"
      },
      {
        "command": "caspian.showEmulatorScreen",
        "title": "显示模拟器屏幕"
      },
      {
        "command": "caspian.refreshFiles",
        "title": "刷新文件列表"
      },
      {
        "command": "caspian.pullFile",
        "title": "从设备下载文件"
      },
      {
        "command": "caspian.pushFile",
        "title": "向设备上传文件"
      },
      {
        "command": "caspian.deleteFile",
        "title": "删除设备上的文件"
      },
      {
        "command": "caspian.createFolder",
        "title": "在设备上创建文件夹"
      },
      {
        "command": "caspian.renameFile",
        "title": "重命名设备上的文件"
      },
      {
        "command": "caspian.openRemoteFile",
        "title": "打开设备上的文件"
      },
      {
        "command": "caspian.selectDevice",
        "title": "选择当前设备"
      },
      {
        "command": "caspian.showOutput",
        "title": "显示输出日志"
      },
      {
        "command": "caspian.listPackages",
        "title": "列出已安装的应用"
      },
      {
        "command": "caspian.launchApp",
        "title": "启动应用"
      },
      {
        "command": "caspian.forceStopApp",
        "title": "强制停止应用"
      },
      {
        "command": "caspian.clearAppData",
        "title": "清除应用数据"
      },
      {
        "command": "caspian.uninstallApp",
        "title": "卸载应用"
      },
      {
        "command": "caspian.showAppLogcat",
        "title": "显示应用日志"
      },
      {
        "command": "caspian.cloneAvd",
        "title": "克隆虚拟设备"
      },
      {
        "command": "caspian.coldBootAvd",
        "title": "冷启动模拟器"
      },
      {
        "command": "caspian.connectWifi",
        "title": "通过 Wi-Fi 连接设备"
      },
      {
        "command": "caspian.disconnectWifi",
        "title": "断开 Wi-Fi 设备"
      },
      {
        "command": "caspian.qrPair",
        "title": "通过二维码配对设备"
      },
      {
        "command": "caspian.checkAvdDisplay",
        "title": "检查设备配置"
      },
      {
        "command": "caspian.repairAvd",
        "title": "修复虚拟设备"
      },
      {
        "command": "caspian.checkAcceleration",
        "title": "检查模拟器加速"
      },
      {
        "command": "caspian.showEmulatorLog",
        "title": "显示模拟器启动日志"
      },
      {
        "command": "caspian.toggleDemoMode",
        "title": "切换截图模式"
      },
      {
        "command": "caspian.captureStoreScreenshots",
        "title": "截取商店截图"
      },
      {
        "command": "caspian.runCaptureMatrix",
        "title": "运行多语言与无障碍矩阵"
      },
      {
        "command": "caspian.openCaptureFolder",
        "title": "打开截图文件夹"
      },
      {
        "command": "caspian.resetDeviceOverrides",
        "title": "重置设备显示与语言覆盖"
      },
      {
        "command": "caspian.setDisplayCutout",
        "title": "设置屏幕刘海"
      },
      {
        "command": "caspian.setNavigationMode",
        "title": "设置导航栏模式"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "caspian",
          "title": "Caspian 模拟器",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "caspian": [
        {
          "id": "caspian.avdList",
          "name": "虚拟设备"
        },
        {
          "id": "caspian.deviceList",
          "name": "已连接的设备"
        },
        {
          "id": "caspian.fileExplorer",
          "name": "设备文件"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "caspian.avdList",
        "contents": "未检测到 Android SDK。\nCaspian 可以自动下载并配置 SDK — 无需安装 Android Studio。\n[$(cloud-download) 下载并安装 Android SDK](command:caspian.downloadSdk)\n[$(gear) 手动配置 SDK](command:caspian.setupSdk)"
      },
      {
        "view": "caspian.deviceList",
        "contents": "没有连接的设备。\n从上方面板启动虚拟设备，或连接手机。\n[$(plug) 通过 USB 连接手机](command:caspian.connectPhone)\n[$(radio-tower) 通过 Wi-Fi 连接](command:caspian.connectWifi)"
      },
      {
        "view": "caspian.fileExplorer",
        "contents": "未选择设备。\n连接设备或启动模拟器以浏览其文件。\n[$(device-mobile) 选择设备](command:caspian.selectDevice)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "caspian.refreshAvds",
          "when": "view == caspian.avdList",
          "group": "navigation"
        },
        {
          "command": "caspian.createAvd",
          "when": "view == caspian.avdList",
          "group": "navigation"
        },
        {
          "command": "caspian.refreshDevices",
          "when": "view == caspian.deviceList",
          "group": "navigation"
        },
        {
          "command": "caspian.refreshFiles",
          "when": "view == caspian.fileExplorer",
          "group": "navigation"
        },
        {
          "command": "caspian.pushFile",
          "when": "view == caspian.fileExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "caspian.launchAvd",
          "when": "view == caspian.avdList && viewItem =~ /^avd\\.stopped/",
          "group": "inline"
        },
        {
          "command": "caspian.stopAvd",
          "when": "view == caspian.avdList && viewItem =~ /^avd\\.running/",
          "group": "inline"
        },
        {
          "command": "caspian.editAvd",
          "when": "view == caspian.avdList",
          "group": "1_edit"
        },
        {
          "command": "caspian.deleteAvd",
          "when": "view == caspian.avdList && viewItem =~ /^avd\\.stopped/",
          "group": "2_delete"
        },
        {
          "command": "caspian.connectPhone",
          "when": "view == caspian.deviceList && viewItem == device.unauthorized",
          "group": "inline"
        },
        {
          "command": "caspian.installApk",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "1_actions"
        },
        {
          "command": "caspian.takeScreenshot",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "1_actions"
        },
        {
          "command": "caspian.recordScreen",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "1_actions"
        },
        {
          "command": "caspian.openShell",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "2_tools"
        },
        {
          "command": "caspian.showLogcat",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "2_tools"
        },
        {
          "command": "caspian.showEmulatorScreen",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "2_tools"
        },
        {
          "command": "caspian.pullFile",
          "when": "view == caspian.fileExplorer && viewItem == file",
          "group": "inline"
        },
        {
          "command": "caspian.createFolder",
          "when": "view == caspian.fileExplorer && viewItem == folder",
          "group": "1_create"
        },
        {
          "command": "caspian.renameFile",
          "when": "view == caspian.fileExplorer && viewItem =~ /^(file|folder)$/",
          "group": "1_create"
        },
        {
          "command": "caspian.openRemoteFile",
          "when": "view == caspian.fileExplorer && viewItem == file",
          "group": "inline"
        },
        {
          "command": "caspian.deleteFile",
          "when": "view == caspian.fileExplorer && viewItem =~ /^(file|folder)$/",
          "group": "2_delete"
        },
        {
          "command": "caspian.launchApp",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "0_apps"
        },
        {
          "command": "caspian.forceStopApp",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "0_apps"
        },
        {
          "command": "caspian.clearAppData",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "0_apps"
        },
        {
          "command": "caspian.uninstallApp",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "0_apps"
        },
        {
          "command": "caspian.cloneAvd",
          "when": "view == caspian.avdList",
          "group": "1_edit"
        },
        {
          "command": "caspian.coldBootAvd",
          "when": "view == caspian.avdList && viewItem =~ /^avd\\.stopped/",
          "group": "inline"
        },
        {
          "command": "caspian.checkAvdDisplay",
          "when": "view == caspian.avdList && viewItem =~ /brokenDisplay|lowRam/",
          "group": "inline"
        },
        {
          "command": "caspian.checkAvdDisplay",
          "when": "view == caspian.avdList",
          "group": "1_edit"
        },
        {
          "command": "caspian.repairAvd",
          "when": "view == caspian.avdList && viewItem =~ /^avd\\.running/",
          "group": "inline"
        },
        {
          "command": "caspian.repairAvd",
          "when": "view == caspian.avdList",
          "group": "3_diagnostics"
        },
        {
          "command": "caspian.showEmulatorLog",
          "when": "view == caspian.avdList",
          "group": "3_diagnostics"
        },
        {
          "command": "caspian.captureStoreScreenshots",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "3_capture"
        },
        {
          "command": "caspian.runCaptureMatrix",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "3_capture"
        },
        {
          "command": "caspian.toggleDemoMode",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "3_capture"
        },
        {
          "command": "caspian.setDisplayCutout",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "3_capture"
        },
        {
          "command": "caspian.setNavigationMode",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "3_capture"
        },
        {
          "command": "caspian.resetDeviceOverrides",
          "when": "view == caspian.deviceList && viewItem =~ /^device\\.(emulator|physical)$/",
          "group": "3_capture"
        }
      ]
    },
    "keybindings": [
      {
        "command": "caspian.showLogcat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l"
      },
      {
        "command": "caspian.selectDevice",
        "key": "ctrl+shift+d",
        "mac": "cmd+shift+d"
      },
      {
        "command": "caspian.showOutput",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      }
    ]
  },
  "extensionPack": [
    "CaspianTools.caspian-emulator"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}
